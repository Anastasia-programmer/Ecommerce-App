    {
      "name": "4. OAuth 2.0",
      "item": [
        {
          "name": "Create a product (OAuth 2.0 token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "string"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "{{baseUrl}}/oauth/token",
                  "type": "string"
                },
                {
                  "key": "clientId",
                  "value": "{{clientId}}",
                  "type": "string"
                },
                {
                  "key": "clientSecret",
                  "value": "{{clientSecret}}",
                  "type": "string"
                },
                {
                  "key": "client_authentication",
                  "value": "header",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                },
                {
                  "key": "tokenName",
                  "value": "Maktaba OAuth token",
                  "type": "string"
                }
              ]
            },
            "description": "Authorization tab → OAuth 2.0 → Grant type Client Credentials → \"Get New Access Token\" → \"Use Token\", then Send.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Created with OAuth 2.0\",\n  \"author\": \"Kateb Yacine\",\n  \"description\": \"A poetic, fragmented novel that continues the world of Nedjma.\",\n  \"price\": 1300,\n  \"category\": \"Novels\",\n  \"imageUrl\": \"\",\n  \"stock\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products"
          }
        }
      ]
    },
    {
      "name": "5. Rate limiting (run last)",
      "item": [
        {
          "name": "Login (send 6+ times → 429)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "description": "Limit: 5 login requests per 15 minutes per IP. Run this request 6 times (or use the Collection Runner with 6 iterations).",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"darine@maktaba.dz\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get all products (send 100+ times → 429)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "description": "Limit: 100 /api requests per 15 minutes per IP. Use the Collection Runner with 101 iterations on this request only.",
            "header": [],
            "url": "{{baseUrl}}/products"
          }
        }
      ]
    }
  ]
