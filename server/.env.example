PORT=3000

# Leave empty to use a temporary in-memory MongoDB (nothing to install).
# Or set a real one, e.g. mongodb://127.0.0.1:27017/maktaba or a MongoDB Atlas URI.
MONGODB_URI=

JWT_SECRET=replace_with_a_local_secret

# React dev server allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# OAuth 2.0 client (Client Credentials grant) used by Postman / Thunder Client
OAUTH_CLIENT_ID=maktaba-postman
OAUTH_CLIENT_SECRET=replace_with_a_client_secret
